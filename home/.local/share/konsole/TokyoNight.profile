[General]
Name=TokyoNight
Parent=FALLBACK/
Command=/bin/fish
LocalTabTitleFormat=%u
RemoteTabTitleFormat=%h

[Appearance]
ColorScheme=TokyoNight
Font=JetBrainsMono Nerd Font,14,-1,5,50,0,0,0,0,0

[Interaction Options]
AutoCopySelectedText=true
TrimLeadingSpacesInSelectedText=true

[Scrolling]
HistorySize=100000
ScrollBarPosition=2

[Terminal Features]
BlinkCursorOnFocus=false
