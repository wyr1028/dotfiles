{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "CachyOS_small",
    "padding": { "top": 2, "left": 4, "right": 4 },
    "color": {
      "1": "#7aa2f7",
      "2": "#bb9af7",
      "3": "#7dcfff",
      "4": "#9ece6a"
    }
  },

  "display": {
    "separator": "    ",
    "key": { "width": 11 }
  },

  "modules": [
    { "type": "break" },

    {
      "type": "title",
      "keyColor": "#7aa2f7",
      "color": { "user": "#9ece6a", "host": "#7dcfff" }
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m────────────────────────\u001b[0m"
    },

    { "type": "os",       "key": "  \uf17c  OS",      "keyColor": "#bb9af7", "color": "#c0caf5" },
    { "type": "kernel",   "key": "  \uf17c  Kernel",  "keyColor": "#bb9af7", "color": "#c0caf5" },
    { "type": "uptime",   "key": "  \uf017  Uptime",  "keyColor": "#bb9af7", "color": "#c0caf5" },
    { "type": "packages", "key": "  \uf487  Packages","keyColor": "#bb9af7", "color": "#c0caf5" },
    { "type": "shell",    "key": "  \uf120  Shell",   "keyColor": "#bb9af7", "color": "#c0caf5" },
    { "type": "wm",       "key": "  \uf108  WM",      "keyColor": "#bb9af7", "color": "#c0caf5" },

    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m────────────────────────\u001b[0m"
    },

    { "type": "cpu",      "key": "  \uf4bc  CPU",     "keyColor": "#9ece6a", "color": "#c0caf5" },
    { "type": "gpu",      "key": "  \uf2a3  GPU",     "keyColor": "#9ece6a", "color": "#c0caf5" },
    { "type": "memory",   "key": "  \uf233  Memory",  "keyColor": "#9ece6a", "color": "#c0caf5" },
    { "type": "disk",     "key": "  \uf0a0  Disk",    "keyColor": "#9ece6a", "color": "#c0caf5" },

    { "type": "break" }
  ]
}
