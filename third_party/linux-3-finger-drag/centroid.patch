+    /// Mean position, in device units, of the given active slots.
+    fn centroid(&self, active: &[usize]) -> (f64, f64) {
+        let mut sx = 0.0;
+        let mut sy = 0.0;
+        for &slot in active {
+            sx += self.slots[slot].x as f64;
+            sy += self.slots[slot].y as f64;
+        }
+        let n = active.len() as f64;
+        (sx / n, sy / n)
+    }
