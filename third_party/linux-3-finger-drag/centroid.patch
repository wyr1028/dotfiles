+/// The drag follows the centroid of all three fingers: moving the whole
+/// group moves the cursor by the group's displacement, while a single
+/// finger's movement only moves it by that finger's 1/3 share. One
+/// noisy finger therefore can't yank the drag around.
+#[test]
+fn drag_follows_three_finger_centroid() {
+    let mut sim = Sim::new();
+    start_drag(&mut sim);
+
+    // whole group +10 units = +12px
+    let outs = sim.frame_at(10, &mv_all(10, 0));
+    assert_eq!(total_move(&outs), (12, 0));
+
+    // only slot 0 advances 30 units: the centroid moves 10 units = 12px
+    // (single-reference tracking would have produced 36px here)
+    let outs = sim.frame_at(10, &mv(0, 540, 500));
+    assert_eq!(total_move(&outs), (12, 0));
+
+    // only slot 1 advances 30 units: same 1/3 share of the motion
+    let outs = sim.frame_at(10, &mv(1, 640, 500));
+    assert_eq!(total_move(&outs), (12, 0));
+}
